# Where the SQLite database lives (defaults to ./data/agentpal.db)
# DATABASE_PATH=/var/data/agentpal.db

# Protects /api/cron/reminders. Call it daily with: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=change-me

# Email notifications via Resend (https://resend.com). Leave blank to disable.
RESEND_API_KEY=
EMAIL_FROM="AgentPal <notifications@yourdomain.com>"

# SMS notifications via Twilio. Leave blank to disable. Requires A2P 10DLC registration in the US.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# The admin login (gets the Admin tab: agent list, CSV export, notifications).
# Created automatically on startup. Change ADMIN_PASSWORD and restart to reset it.
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=pick-a-long-password
ADMIN_NAME=Your Name
ADMIN_PHONE=3125550100
